# Copy with: python3 scripts/auth.py init (generates random local secrets).
# Never commit the generated .env. These are placeholders, not usable credentials.
KEYCLOAK_DB_PASSWORD=replace-with-generated-local-secret
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=local-bootstrap
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-generated-local-secret
MAGNUM_WEB_CLIENT_SECRET=replace-with-generated-local-secret
# Future Phoenix settings only; Phoenix does not read these in this milestone.
OIDC_ISSUER=http://auth.magnum.test:8080/realms/magnum
OIDC_CLIENT_ID=magnum-web
OIDC_REDIRECT_URI=http://localhost:4000/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
# OIDC_CLIENT_SECRET must equal MAGNUM_WEB_CLIENT_SECRET, server-side only.
# SMTP is fixed to auth-mail:1025, without credentials/TLS, on the internal network.
